modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "discord_bot_checker"

[[workflows.workflow]]
name = "Discord Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install discord.js @discordjs/voice @discordjs/rest axios && node index.js"

[[workflows.workflow]]
name = "discord_bot_checker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm list --depth=0 || echo \"No packages installed\"; cat package.json 2>/dev/null || echo \"No package.json found\""

[deployment]
run = ["sh", "-c", "npm install discord.js @discordjs/voice @discordjs/rest axios && node index.js"]
